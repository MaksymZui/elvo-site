---
import hero from '../assets/sections/hero.webp';
import heroMobile from '../assets/sections/hero-mobile.webp';
import Header from '../components/Header.astro';
import Contact from '../components/sections/Contact.astro';
import Drones from '../components/sections/Drones.astro';
import Hero from '../components/sections/Hero.astro';
import Payload from '../components/sections/Payload.astro';
import Solutions from '../components/sections/Solutions.astro';
import Thermal from '../components/sections/Thermal.astro';
import { site } from '../content/site';
import Base from '../layouts/Base.astro';
import { artSources } from '../lib/art';

const heroPreloads = (await artSources(heroMobile, hero)).filter(
  (source) => source.type === 'image/avif',
);
---

<Base>
  <Fragment slot="head">
    {heroPreloads.map((source) => (
      <link
        rel="preload"
        as="image"
        type={source.type}
        media={source.media}
        imagesrcset={source.srcset}
        imagesizes={source.sizes}
        fetchpriority="high"
      />
    ))}
  </Fragment>
  <Header />
  <main id="main" data-slides-label={site.sectionsLabel}>
    <div class="screens">
      <Hero />
      <Drones />
      <Payload />
      <Thermal />
      <Solutions />
      <Contact />
    </div>
  </main>
</Base>

<script>
  import '../scripts/motion';
</script>
