---
import Logo from '../assets/logo.svg';
import { site } from '../content/site';
import Icon from './Icon.astro';
---

<header class="header">
  <div class="header__bar px-gutter">
    <a href="#top" class="header__logo" aria-label={site.homeLabel}>
      <Logo class="h-6 w-auto lg:h-7" aria-hidden="true" />
    </a>

    <nav class="hidden md:block" aria-label={site.menu.label}>
      <ul class="flex items-center gap-6 lg:gap-8">
        {site.nav.map((item) => (
          <li>
            <a class="nav-link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a class="btn btn--small" href="#contact">
        {site.contactLabel}
      </a>
      <button class="icon-btn md:hidden" popovertarget="menu" aria-label={site.menu.open}>
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <div id="menu" popover class="menu px-gutter">
    <div class="menu__bar">
      <Logo class="h-6 w-auto" aria-hidden="true" />
      <button
        class="icon-btn"
        popovertarget="menu"
        popovertargetaction="hide"
        aria-label={site.menu.close}
        autofocus
      >
        <Icon name="x" class="size-6" />
      </button>
    </div>
    <nav aria-label={site.menu.label}>
      <ul class="flex flex-col gap-2">
        {site.nav.map((item) => (
          <li>
            <a class="menu__link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn self-start" href="#contact">
      {site.contactLabel}
    </a>
  </div>
</header>

<script>
  const menu = document.getElementById('menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.hidePopover();
  });
</script>
