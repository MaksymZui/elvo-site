---
import type { HeadingLines } from '../content/site';

interface Props {
  as?: 'h1' | 'h2';
  lines: HeadingLines;
  class?: string;
}

const { as: Tag = 'h2', lines, class: className, ...rest } = Astro.props;
---

<Tag class:list={['display', className]} {...rest}>
  {lines.map((line) => (
    <span class="block">
      {line.map((part) =>
        typeof part === 'string' ? (
          part
        ) : (
          <span class={part.accent ? 'text-accent' : undefined}>{part.text}</span>
        ),
      )}
    </span>
  ))}
</Tag>
