---
import hero from '../../assets/sections/hero.webp';
import heroMobile from '../../assets/sections/hero-mobile.webp';
import { site } from '../../content/site';
import ArtPicture from '../ArtPicture.astro';
import Heading from '../Heading.astro';
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import Tagline from '../Tagline.astro';

const { heading, imageAlt, features } = site.hero;
---

<section id="top" class="hero" data-section>
  <div class="hero__media" data-parallax>
    <ArtPicture mobile={heroMobile} desktop={hero} alt={imageAlt} eager />
  </div>
  <div class="hero__content px-gutter">
    <div class="copy">
      <Tagline class="hero__tagline" />
      <Heading as="h1" lines={heading} class="display--hero" data-split />
    </div>
    <ul class="features copy">
      {
        features.map((feature) => (
          <li class="features__item" data-reveal>
            <Icon name={feature.icon as IconName} class="features__icon" />
            <p>
              <strong class="block font-semibold">{feature.title}</strong>
              <span class="block text-muted">{feature.text}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
