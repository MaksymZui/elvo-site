---
import { Picture } from 'astro:assets';
import drones from '../../assets/sections/drones.webp';
import dji from '../../assets/sections/drones-dji.webp';
import autel from '../../assets/sections/drones-autel.webp';
import { site } from '../../content/site';
import Heading from '../Heading.astro';
import Screen from '../Screen.astro';

const { heading, imageAlt, models } = site.drones;
const crops = { dji, autel };
const formats = ['avif', 'webp'] as ('avif' | 'webp')[];
---

<Screen id="drones" class="stage stage--drones">
  <div class="stage__media hidden wide:flex">
    <div class="frame" data-zoom>
      <Picture
        src={drones}
        alt={imageAlt}
        formats={formats}
        fallbackFormat="webp"
        widths={[1280, 1920]}
        sizes="max(100vw, 160vh)"
        quality={60}
      />
      <svg class="callouts" viewBox="0 0 1280 800" aria-hidden="true" data-reveal>
        <path d="M697 296H570L549 318" stroke="var(--color-icon)" />
        <circle cx="548" cy="319" r="3" fill="var(--color-brand)" />
        <path d="M1226 308H1070L1046 327" stroke="var(--color-brand-yellow)" />
        <circle cx="1045" cy="328" r="3" fill="var(--color-brand-yellow)" />
      </svg>
      {models.map((model) => (
        <p class={`callout callout--${model.id}`} data-reveal>
          {model.name}
        </p>
      ))}
    </div>
  </div>

  <div class="stage__copy px-gutter">
    <Heading lines={heading} class="display--compact" />
  </div>

  <div class="models px-gutter">
    {models.map((model) => (
      <figure>
        <Picture
          pictureAttributes={{ class: 'model__image', 'data-reveal': true }}
          src={crops[model.id as keyof typeof crops]}
          alt={model.alt}
          formats={formats}
          fallbackFormat="webp"
          widths={[360, 768, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          quality={60}
        />
        <figcaption class="model__name" data-reveal>
          {model.name}
        </figcaption>
      </figure>
    ))}
  </div>
</Screen>
