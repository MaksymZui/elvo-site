---
import payload from '../../assets/sections/payload.webp';
import payloadMobile from '../../assets/sections/payload-mobile.webp';
import { site } from '../../content/site';
import ArtPicture from '../ArtPicture.astro';
import Heading from '../Heading.astro';
import Screen from '../Screen.astro';

const { heading, text, imageAlt } = site.payload;
---

<Screen id="payload" class="stage">
  <div class="stage__media">
    <div class="frame" data-zoom>
      <ArtPicture mobile={payloadMobile} desktop={payload} alt={imageAlt} />
    </div>
  </div>
  <div class="stage__copy px-gutter">
    <div class="wide:ml-auto wide:w-[47%]">
      <Heading lines={heading} />
      <p class="lead" data-reveal>
        {text}
      </p>
    </div>
  </div>
</Screen>
