---
import fiber from '../../assets/sections/fiber.webp';
import fiberMobile from '../../assets/sections/fiber-mobile.webp';
import { site } from '../../content/site';
import ArtPicture from '../ArtPicture.astro';
import Heading from '../Heading.astro';
import Screen from '../Screen.astro';

const { heading, standard, text, imageAlt } = site.fiber;

// Light runs from the cable end to the fiber tips, in pixels of the 1280x800 frame
const lines = [
  'M884 436C780 434 690 444 533 441',
  'M884 444C770 450 660 460 487 467',
  'M886 454C770 464 650 489 510 525',
  'M880 440C800 424 700 420 587 423',
  'M884 462C790 484 700 510 608 544',
];
---

<Screen id="fiber" class="stage">
  <div class="stage__media">
    <div class="frame" data-zoom>
      <ArtPicture mobile={fiberMobile} desktop={fiber} alt={imageAlt} />
      <svg class="fiber-light" viewBox="0 0 1280 800" aria-hidden="true" data-fiber-light>
        {lines.map((d) => (
          <path d={d} />
        ))}
      </svg>
    </div>
  </div>
  <div class="stage__copy px-gutter">
    <Heading lines={heading} class="display--one-line" />
    <p class="standard" data-reveal>
      {standard}
    </p>
    <span class="rule" aria-hidden="true" data-reveal></span>
    <p class="lead lead--narrow" data-reveal>
      {text}
    </p>
  </div>
</Screen>
