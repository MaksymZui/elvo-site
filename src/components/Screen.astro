---
import { site } from '../content/site';

interface Props {
  id: keyof typeof site.sections;
  class?: string;
}

const { id, class: className } = Astro.props;
const label = site.sections[id];
---

<section id={id} class="screen" aria-label={label} data-section data-hash={id} data-label={label}>
  <div class:list={['screen__body', className]} data-screen-body>
    <slot />
  </div>
</section>
